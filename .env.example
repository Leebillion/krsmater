PORT=3100

# Optional: pin a specific Python executable when `python` / `py` discovery is unreliable.
# Example (Windows): C:\Users\<user>\AppData\Local\Programs\Python\Python310\python.exe
PYTHON_EXECUTABLE=

# Optional: pin the Tesseract executable path when it is not available on PATH.
# Example (Windows): C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# 마스터 편집(editor/, Python) 연동. 자세한 내용은 MASTER_EDITOR.md.
# 현재 마스터·번들 마스터 교체는 관리자만 가능하며, 관리자 확인을 이 편집 서버에 묻는다.
EDITOR_INTERNAL_URL=http://127.0.0.1:8000
# 마스터 편집의 '사이트 현재 마스터로 게시'가 보내는 공유 비밀값. editor/.env의 같은 이름 값과 똑같이 맞춘다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EDITOR_SHARED_TOKEN=
