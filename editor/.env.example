# 마스터 편집 서버(editor/) 설정. 이 파일을 editor/.env로 복사해서 채운다. 절대 공유·커밋하지 않는다.

# 관리자(마스터 편집) 공용 비밀번호
APP_PASSWORD=

# 로그인 쿠키 서명 키(긴 무작위 문자열). 비워 두면 재시작할 때마다 모두 로그아웃된다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 공유 DB(종량제·번들·단축·서비스·담배·삭제한 행·검색어)와 업로드 임시 파일 위치
DATA_DIR=/var/lib/krs-editor
# DB가 없을 때 처음 한 번 복사해 올 데스크톱 앱 DB(선택)
SEED_DB=

# '사이트 현재 마스터로 게시'를 보낼 KRS Master API 주소와 공유 비밀값(사이트 .env의 EDITOR_SHARED_TOKEN과 같게)
SITE_API_URL=http://127.0.0.1:3100
EDITOR_SHARED_TOKEN=

# HTTPS(nginx) 뒤에서는 1. 로컬 http 확인 때만 0
COOKIE_SECURE=1
